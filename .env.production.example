# Production env template — copy to .env.production on VPS, never commit real values.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=docsaas
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
POSTGRES_DB=docsaas

DATABASE_URL=postgresql+psycopg2://docsaas:CHANGE_ME_STRONG_PG_PASSWORD@db:5432/docsaas
PII_SCHEMA=pii
PII_RETENTION_DAYS=0

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_EXPIRE_MINUTES=1440

# Production domain(s), comma-separated
CORS_ORIGINS=https://YOUR_DOMAIN.example

STORAGE_BACKEND=local
LOCAL_BLOB_ROOT=/app/.runtime/blobs

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
ARTIFACT_TTL_HOURS=24

PDF_ENGINE=dxpdf

# Optional SMTP for contact forms + password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@YOUR_DOMAIN.example
SMTP_TO=
SMTP_USE_TLS=true

# Frontend origin used in password-reset + unsubscribe links
PUBLIC_APP_URL=https://YOUR_DOMAIN.example
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RATE_PER_HOUR=5

# Platform marketing broadcasts (banners / offers) — owner API
MARKETING_CAMPAIGNS_ENABLED=true
DEBUG=false
