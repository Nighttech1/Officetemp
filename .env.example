# Root env for docker compose. Copy to .env — do not commit secrets.

POSTGRES_USER=docsaas
POSTGRES_PASSWORD=docsaas
POSTGRES_DB=docsaas

# Stage/VPS: only postgresql+… (sqlite — pytest only).
DATABASE_URL=postgresql+psycopg2://docsaas:docsaas@db:5432/docsaas
PII_SCHEMA=pii
PII_RETENTION_DAYS=0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Files on VPS disk (default). Optional MinIO: STORAGE_BACKEND=s3 + profile objectstore
STORAGE_BACKEND=local
LOCAL_BLOB_ROOT=/app/.runtime/blobs

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docsaas
S3_REGION=us-east-1

PDF_ENGINE=dxpdf
DATA_MAX_ROWS=5000
GOOGLE_SERVICE_ACCOUNT_JSON=
YANDEX_SHEETS_TOKEN=
YANDEX_DISK_TOKEN=

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
ARTIFACT_TTL_HOURS=24
