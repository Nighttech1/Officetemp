# Copy to .env and adjust. Never commit real secrets.
#
# Stage / VPS / повседневная разработка облачного ЛК:
#   DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/DB
# SQLite разрешён ТОЛЬКО для pytest (conftest выставляет сам).

DATABASE_URL=postgresql+psycopg2://docsaas:docsaas@127.0.0.1:5432/docsaas
PII_SCHEMA=pii
PII_RETENTION_DAYS=0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# MVP / first VPS: files on disk (same server, separate volume)
STORAGE_BACKEND=local
LOCAL_BLOB_ROOT=

# Optional later: STORAGE_BACKEND=s3 + MinIO/Yandex
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docsaas
S3_REGION=us-east-1

PDF_ENGINE=dxpdf
DATA_MAX_ROWS=5000
GOOGLE_SERVICE_ACCOUNT_JSON=
YANDEX_SHEETS_TOKEN=
YANDEX_DISK_TOKEN=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
ARTIFACT_TTL_HOURS=24

MARKETING_CAMPAIGNS_ENABLED=true

# Password reset links point here (frontend origin)
PUBLIC_APP_URL=http://127.0.0.1:3000
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RATE_PER_HOUR=5

# Optional SMTP (empty = log reset link when DEBUG=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@docsaas.local
SMTP_TO=
SMTP_USE_TLS=true
